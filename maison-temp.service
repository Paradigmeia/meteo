[Unit]
Description=Maison Temp — Backend FastAPI
After=network.target

[Service]
User=debian
WorkingDirectory=/home/debian/meteo/backend
EnvironmentFile=/home/debian/meteo/backend/.env
# --no-access-log : uvicorn journalisait la ligne de requête complète, clé d'API
# du webhook Shelly comprise, dans le journal systemd (issue #35). Ces lignes
# faisaient double emploi avec celles de nginx, seul point d'entrée — uvicorn
# n'écoute que sur 127.0.0.1. Les logs d'erreur et d'application sont conservés.
ExecStart=/home/debian/meteo/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8042 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
